# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Anthropic (question generation, evaluation, goal chatbot — direct API, not Bedrock)
ANTHROPIC_API_KEY=your-anthropic-api-key

# xAI Grok (hallucination checker)
XAI_API_KEY=your-xai-api-key

# Microsoft Entra ID (Azure AD)
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret
ENTRA_AUTHORITY=https://login.microsoftonline.com/your-tenant-id

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# App
CORS_ORIGINS=http://localhost:9203
SUPABASE_STORAGE_BUCKET=documents
